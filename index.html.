        recalcular();
    }

    function recalcular() {
        cuentaTotal = (miPedido['Mazapan'] || 0) * 25 + 
                      (miPedido['Oreo'] || 0) * 25 + 
                      (miPedido['Duvalin'] || 0) * 25 + 
                      (miPedido['Mango'] || 0) * 20 + 
                      (miPedido['Jamaica'] || 0) * 20;
        document.getElementById('suma').innerText = cuentaTotal;
    }

