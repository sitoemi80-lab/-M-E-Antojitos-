        if (cuentaTotal === 0) return alert("Selecciona al menos un boli");
        let texto = "¡Hola! 👋 Quiero este pedido de M&I Antojitos:%0A";
        for (let x in miPedido) {
            if (miPedido[x] > 0) texto += "- " + miPedido[x] + " de " + x + "%0A";
        }
        texto += "%0A*Total a pagar: $" + cuentaTotal + "*";
        window.open("https://wa.me/525580830028?text=" + texto);
    }
